# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROWW_API_TOKEN: Optional Groww Trading API Bearer/Access token for live broker market data.
# When omitted, the built-in Groww MCP server generates realistic high-fidelity real-time NSE market ticks.
GROWW_API_TOKEN=""

# DHAN_CLIENT_ID: Optional Dhan 10-digit Client ID for official Dhan MCP server (https://mcp.dhan.co/mcp).
DHAN_CLIENT_ID=""

# DHAN_ACCESS_TOKEN: Optional DhanHQ Trading Access Token (JWT) from web.dhan.co for live trading via MCP.
DHAN_ACCESS_TOKEN=""

# RAZORPAY_KEY_ID: Razorpay Key ID (rzp_test_... or rzp_live_...) for Indian INR payment gateway (UPI, RuPay, Net Banking).
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Razorpay Key Secret for verifying webhook & HMAC SHA256 payment signatures.
RAZORPAY_KEY_SECRET=""

# STRIPE_SECRET_KEY: Stripe secret API key (sk_test_... or sk_live_...) for subscription billing & payment gateway.
# When omitted, FINAGENT seamlessly runs in Sandbox Payment Mode with simulated gateway checkout.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Optional Stripe webhook signing secret (whsec_...) for real-time subscription lifecycle sync.
STRIPE_WEBHOOK_SECRET=""
